{
  "name": "Bihan",
  "version": "1.0.0",
  "theme": "dark",
  "color": {
    "bg": "#0a0a0f",
    "surface": {
      "1": "#14141c",
      "2": "#1d1d28",
      "3": "#272735"
    },
    "border": {
      "DEFAULT": "#2c2c3a",
      "strong": "#62627a"
    },
    "ink": {
      "DEFAULT": "#f4f4f7",
      "muted": "#a3a3b5",
      "subtle": "#86869c",
      "on-gold": "#16110a"
    },
    "gold": {
      "DEFAULT": "#ffc93c",
      "hover": "#ffd768"
    },
    "grade": {
      "s": "#ffc93c",
      "a": "#3ddc84",
      "b": "#41b6ff",
      "c": "#ff9f43",
      "d": "#ff4d5e",
      "cal": "#8a8aa0",
      "s-dim": "rgba(255, 201, 60, 0.16)",
      "a-dim": "rgba(61, 220, 132, 0.16)",
      "b-dim": "rgba(65, 182, 255, 0.16)",
      "c-dim": "rgba(255, 159, 67, 0.16)",
      "d-dim": "rgba(255, 77, 94, 0.16)"
    },
    "chart": {
      "grid": "#23232f",
      "line": "#f4f4f7"
    },
    "overlay": "rgba(5, 5, 9, 0.72)",
    "error": "#ff4d5e"
  },
  "grades": [
    { "grade": "S", "min": 90, "max": 100, "label": "Locked In", "color": "#ffc93c", "dim": "rgba(255, 201, 60, 0.16)" },
    { "grade": "A", "min": 75, "max": 89, "label": "Strong", "color": "#3ddc84", "dim": "rgba(61, 220, 132, 0.16)" },
    { "grade": "B", "min": 60, "max": 74, "label": "On Track", "color": "#41b6ff", "dim": "rgba(65, 182, 255, 0.16)" },
    { "grade": "C", "min": 40, "max": 59, "label": "Slipping", "color": "#ff9f43", "dim": "rgba(255, 159, 67, 0.16)" },
    { "grade": "D", "min": 0, "max": 39, "label": "Off Track", "color": "#ff4d5e", "dim": "rgba(255, 77, 94, 0.16)" },
    { "grade": "CAL", "min": null, "max": null, "label": "Calibrating", "color": "#8a8aa0", "dim": "#1d1d28", "note": "Goal under 3 days old" }
  ],
  "font": {
    "family": {
      "display": "\"Unbounded\", \"Inter\", system-ui, sans-serif",
      "sans": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Unbounded:wght@500;600;700;800&display=swap",
    "style": {
      "score-hero": { "family": "display", "size": "88px", "lineHeight": "88px", "weight": 800, "letterSpacing": "-0.03em", "mobileSize": "64px" },
      "score-md": { "family": "display", "size": "40px", "lineHeight": "44px", "weight": 700, "letterSpacing": "-0.02em" },
      "score-sm": { "family": "display", "size": "22px", "lineHeight": "26px", "weight": 700 },
      "grade-letter": { "family": "display", "size": "28px", "lineHeight": "28px", "weight": 800 },
      "display": { "family": "display", "size": "36px", "lineHeight": "42px", "weight": 700, "letterSpacing": "-0.02em", "mobileSize": "28px" },
      "heading-lg": { "family": "display", "size": "22px", "lineHeight": "28px", "weight": 600 },
      "heading-md": { "family": "sans", "size": "17px", "lineHeight": "24px", "weight": 600 },
      "body": { "family": "sans", "size": "15px", "lineHeight": "22px", "weight": 400 },
      "body-sm": { "family": "sans", "size": "13px", "lineHeight": "18px", "weight": 400 },
      "label": { "family": "sans", "size": "11px", "lineHeight": "16px", "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase" },
      "stat": { "family": "sans", "size": "15px", "lineHeight": "20px", "weight": 600, "numeric": "tabular-nums" }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "12": "48px"
  },
  "radius": {
    "sm": "8px",
    "md": "12px",
    "lg": "20px",
    "xl": "28px",
    "full": "9999px"
  },
  "shadow": {
    "modal": "0 24px 64px rgba(0, 0, 0, 0.6)",
    "glow-s": "0 0 32px rgba(255, 201, 60, 0.45)",
    "focus": "0 0 0 3px rgba(255, 201, 60, 0.55)"
  },
  "scoreRing": {
    "hero": { "size": 220, "stroke": 18, "textStyle": "score-hero" },
    "md": { "size": 140, "stroke": 12, "textStyle": "score-md" },
    "sm": { "size": 64, "stroke": 6, "textStyle": "score-sm" }
  },
  "breakpoints": {
    "mobile": "0-767px",
    "desktop": "768px+",
    "maxContentWidth": "1200px"
  }
}
