# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Backend (FastAPI) --------------------------------------------------------

# Matches the db service defaults in docker-compose.yml. If you change the
# postgres user/password/db there, update this too.
DATABASE_URL=postgresql+psycopg2://lifetracker:lifetracker@db:5432/life_tracker

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

JWT_EXPIRES_MINUTES=60

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Frontend (Vite) ----------------------------------------------------------

# Base URL the frontend uses to call the backend API.
VITE_API_URL=http://localhost:8000/api/v1
