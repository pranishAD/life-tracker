# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Backend (FastAPI) --------------------------------------------------------

# Local dev (Docker Compose): matches the db service defaults in
# docker-compose.yml. If you change the postgres user/password/db there,
# update this too.
DATABASE_URL=postgresql+psycopg2://lifetracker:lifetracker@db:5432/life_tracker

# Production (Vercel backend project): use Neon's *pooled* connection string
# instead (copy it from the Neon console "Connect" modal, then swap the
# "postgresql://" scheme for "postgresql+psycopg2://" so SQLAlchemy picks the
# right driver — leave everything else, including the "-pooler" hostname,
# "sslmode=require" and "channel_binding=require", unchanged). Example shape
# (not a real value):
#   DATABASE_URL=postgresql+psycopg2://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
# Never put the real Neon URL in this file — set it as an encrypted env var
# on the backend Vercel project (see README "Deployment" section) and keep
# it out of git.

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me

JWT_EXPIRES_MINUTES=60

# Comma-separated list of origins allowed to call the API.
# Local dev: http://localhost:5173
# Production: add the frontend's deployed Vercel URL(s), e.g.
#   https://life-tracker.vercel.app,https://life-tracker-<preview>.vercel.app
CORS_ORIGINS=http://localhost:5173

# Shared secret for the daily score-snapshot cron endpoint
# (GET /api/v1/internal/daily-snapshot — see README "Deployment").
# Only needed in production. Vercel automatically sends this value as an
# `Authorization: Bearer <CRON_SECRET>` header when it invokes a cron job, so
# set CRON_SECRET on the backend Vercel project and have the endpoint compare
# the incoming Authorization header against it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave blank for local dev (no cron runs locally).
CRON_SECRET=

# Frontend (Vite) ----------------------------------------------------------

# Base URL the frontend uses to call the backend API.
VITE_API_URL=http://localhost:8000/api/v1
