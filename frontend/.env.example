# Copy to frontend/.env when running `npm run dev` directly (outside Docker).
# Docker Compose already injects VITE_API_URL itself (see ../docker-compose.yml),
# so this file only matters for local `npm run dev`.
#
# This local-dev value is an absolute URL because the frontend (5173) and
# backend (8000) run on different origins. In production (Vercel Services,
# one project, same origin — frontend at `/`, backend at `/api/*`), set
# VITE_API_URL to the relative path "/api/v1" instead — the browser will
# then call the backend on the same origin the page was served from, with
# no cross-origin request needed. Both forms are supported by the API client.
VITE_API_URL=http://localhost:8000/api/v1
